<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Naidis_TARpe24.LumememmPage"
             Title="LumememmPage">
    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <!-- Lumememm -->
            <AbsoluteLayout HeightRequest="350">

                <Frame x:Name="Body"
                       BackgroundColor="White"
                       CornerRadius="100"
                       HeightRequest="140"
                       WidthRequest="140"
                       AbsoluteLayout.LayoutBounds="0.5,0.7,140,140"
                       AbsoluteLayout.LayoutFlags="PositionProportional" />

                <Frame x:Name="Head"
                       BackgroundColor="White"
                       CornerRadius="70"
                       HeightRequest="100"
                       WidthRequest="100"
                       AbsoluteLayout.LayoutBounds="0.5,0.4,100,100"
                       AbsoluteLayout.LayoutFlags="PositionProportional" />

                <Frame x:Name="Hat"
                       BackgroundColor="Black"
                       HeightRequest="40"
                       WidthRequest="110"
                       AbsoluteLayout.LayoutBounds="0.5,0.25,110,40"
                       AbsoluteLayout.LayoutFlags="PositionProportional" />

            </AbsoluteLayout>

            <!-- Picker -->
            <Picker x:Name="ActionPicker" Title="Vali tegevus">
                <Picker.Items>
                    <x:String>Peida</x:String>
                    <x:String>Näita</x:String>
                    <x:String>Muuda värvi</x:String>
                    <x:String>Sulata</x:String>
                    <x:String>Tantsi</x:String>
                </Picker.Items>
            </Picker>

            <Button Text="Käivita tegevus"
                    Clicked="OnActionClicked"/>

            <Label x:Name="ResultLabel"
                   FontSize="18"
                   HorizontalOptions="Center"/>

            <!-- Slider -->
            <Label Text="Läbipaistvus"/>
            <Slider Minimum="0"
                    Maximum="1"
                    Value="1"
                    ValueChanged="OnSliderChanged"/>

            <!-- Stepper -->
            <Label Text="Kiirus (ms)"/>
            <Stepper x:Name="SpeedStepper"
                     Minimum="100"
                     Maximum="2000"
                     Increment="100"
                     Value="500"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>